# Copy this file to .env and fill in your own credentials.
DB_HOST=localhost
DB_USER=root
DB_PASS="replace_with_your_mysql_password"
DB_NAME=userdb
PORT=3000

# Gmail credentials for registration verification emails.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS="replace_with_your_gmail_app_password"

# Replace both values with your own random secrets.
ENC_KEY="replace_with_a_random_encryption_key"
SECRET_KEY="replace_with_a_random_secret"
